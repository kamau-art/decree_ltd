# PostgreSQL connection string
# Host port 5434 maps to the container's 5432 (see docker/docker-compose.yml)
DATABASE_URL="postgresql://admin:decree_ltd_pass@localhost:5434/decree_ltd?schema=public"

# NextAuth configuration
NEXTAUTH_SECRET="change-me-to-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Admin user created by the seed script (npm run db:seed)
ADMIN_EMAIL="admin@decree-ltd.com"
ADMIN_PASSWORD="admin123"

# Optional: if port 3000 is taken (e.g. another Next.js project is running)
# PORT=3001
